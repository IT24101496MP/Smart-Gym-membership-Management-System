# ==============================
# Database
# ==============================
DATABASE_URL=jdbc:mysql://localhost:3306/fat2fit_db?createDatabaseIfNotExist=true&serverTimezone=Asia/Colombo
MYSQLUSER=root
MYSQLPASSWORD=

# ==============================
# JWT
# ==============================
JWT_SECRET=change-this-to-a-strong-secret-key

# ==============================
# Default Admin Seed
# ==============================
ADMIN_EMAIL=admin@fat2fit.lk
ADMIN_PASSWORD=Admin@1234
ADMIN_FIRST_NAME=System
ADMIN_LAST_NAME=Admin
ADMIN_PHONE=0700000000

# ==============================
# Email SMTP
# ==============================
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
NOTIFICATION_FROM=no-reply@fat2fit.lk

# ==============================
# Scheduler
# Runs daily at 9:00 AM
# ==============================
MEMBERSHIP_EXPIRY_NOTIFICATION_CRON=0 0 9 * * *

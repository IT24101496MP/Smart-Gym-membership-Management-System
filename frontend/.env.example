# Backend API base URL used by frontend axios client.
# Use "/" when frontend and backend are served from the same domain.
VITE_API_BASE_URL=/

# Dev-only target used by Vite proxy for /api requests.
VITE_DEV_API_TARGET=http://localhost:8080

# PayHere Checkout API does not require merchant credentials on frontend.
# Frontend fetches checkout form params + hash from backend /api/payments/create-intent.
